# LlamaParse (LlamaIndex Cloud) — get from https://cloud.llamaindex.ai/
# Server-side only; used by /api/parse/start (Blob relay) and /api/parse/status
# /api/parse/result. Never exposed to the browser.
LLAMA_CLOUD_API_KEY=

# Vercel Blob — auto-provisioned by Vercel when you enable Blob in Project →
# Storage. The browser uploads files to Blob via a signed URL handed out by
# /api/blob-upload, then /api/parse/start fetches from Blob and forwards to
# LlamaParse. This bypasses the 4.5 MB function body cap on Hobby tier so
# large PPTX / PDF uploads work end-to-end. Set this in Vercel dashboard for
# Production + Preview; for local dev, run `vercel env pull` to fetch it into
# .env.local.
BLOB_READ_WRITE_TOKEN=

# LLM provider — vendor-agnostic OpenAI-compatible.
# Set BASE_URL + API_KEY + MODEL to whichever provider you want.
#
#   OpenRouter:        https://openrouter.ai/api/v1                 LLM_MODEL=google/gemini-2.5-flash
#   Google AI Studio:  https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.5-flash
#   Claude (Anthropic): https://api.anthropic.com/v1                LLM_MODEL=claude-sonnet-4-5
#   OpenAI direct:     https://api.openai.com/v1                    LLM_MODEL=gpt-4o-mini
#   Ollama (local):    http://localhost:11434/v1                    LLM_MODEL=llama3.2
LLM_BASE_URL=h
LLM_API_KEY=
LLM_MODEL=google/gemini-2.5-flash

# Optional — used by the "Regenerate with stronger model" button.
# Defaults to LLM_MODEL if unset.
LLM_MODEL_PRO=google/gemini-2.5-pro
